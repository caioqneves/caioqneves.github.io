---
import T from './T.astro';
import { site } from '../data/site';
---
<div class="behance-wrap" data-reveal>
  <a class="behance-btn" href={site.behance.url} target="_blank" rel="noopener">
    <T pt="Veja mais no Behance" en="See more on Behance" />
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 11.5l7-7M5.5 4.5h6v6" /></svg>
  </a>
</div>
