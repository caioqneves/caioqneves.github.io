---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import T from '../components/T.astro';
import Card from '../components/Card.astro';
import BehanceButton from '../components/BehanceButton.astro';
import { getProjetos } from '../lib/projetos';
import { AREAS } from '../data/areas';
import { site } from '../data/site';

const projetos = await getProjetos();
const anos = projetos.map((p) => p.pt.data.ano).filter((a): a is number => !!a);
const faixa = anos.length ? ` — ${Math.min(...anos)}–${Math.max(...anos)}` : '';

// foto do "Sobre": coloque src/assets/profile.png (ou .jpg)
const fotos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/profile.{png,jpg,jpeg,webp}', { eager: true });
const perfil = Object.values(fotos)[0]?.default;

const svg = (d: string) => `<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const arrow = svg('<path d="M4.5 11.5l7-7M5.5 4.5h6v6"/>');
const copy = svg('<rect x="5.5" y="5.5" width="8" height="8"/><path d="M10.5 5.5v-3h-8v8h3"/>');
const turn = svg('<path d="M3 3v5.5h9.5M9.5 5.5l3 3-3 3"/>');
---
<Layout>
  <main>
    <!-- HERO -->
    <section class="hero wrap">
      <h1 class="hero-title" data-reveal="lines">
        <T html
          pt={'<span class="ln" style="--l:0"><span>Design</span></span><span class="ln" style="--l:1"><span class="accent">Gráfico</span></span><span class="ln" style="--l:2"><span>&amp; UX/UI</span></span>'}
          en={'<span class="ln" style="--l:0"><span>Graphic</span></span><span class="ln" style="--l:1"><span class="accent">Design</span></span><span class="ln" style="--l:2"><span>&amp; UX/UI</span></span>'} />
      </h1>
      <div class="hero-meta" data-reveal>
        <p>Brasil</p>
        <p><T pt="Design Gráfico" en="Graphic Design" /></p>
        <p><T pt="Identidade Visual" en="Visual Identity" /></p>
        <p>UX/UI Design</p>
      </div>
    </section>

    <!-- TRABALHOS -->
    <section class="section wrap" id="trabalhos">
      <div class="toolbar">
        <div class="section-head" data-reveal="line"><span class="kicker quiet"><T pt="Seleção de trabalhos" en="Selected works" />{faixa}</span></div>

        <div class="seg" role="group" aria-label="Filtrar por área" data-reveal>
          <span class="seg-ind" aria-hidden="true"></span>
          <button class="seg-btn" data-area="todos" aria-pressed="true">
            <span><T pt="Todos" en="All" /></span><span class="seg-n">{projetos.length}</span>
          </button>
          {AREAS.map((a) => (
            <button class="seg-btn" data-area={a.id} aria-pressed="false">
              <span><T pt={a.pt} en={a.en} /></span><span class="seg-n">{projetos.filter((p) => p.area === a.id).length}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="grid">
        {projetos.map((p) => <Card projeto={p} />)}
        <p class="grid-vazio" id="gridVazio" hidden><T pt="Ainda não há projetos nesta área." en="No projects in this area yet." /></p>
      </div>
      <BehanceButton />
    </section>

    <!-- SOBRE -->
    <section class="section wrap" id="sobre">
      <div class="about-head" data-reveal>
        <h2 class="about-title"><T pt="Sobre mim" en="About me" /></h2>
        <p class="about-sub"><Fragment set:html={turn} /><T pt="Designer gráfico e de UX/UI baseado no Brasil." en="Graphic and UX/UI designer based in Brazil." /></p>
      </div>
      <div class="about">
        {perfil && <div class="about-photo" data-reveal><Image src={perfil} alt="Caio Q. Neves" widths={[700, 1000, 1400]} sizes="(max-width: 780px) 100vw, 640px" /></div>}
        <div class="about-body" data-reveal>
          <h3 class="about-hi"><T pt="Olá! Sou o Caio Neves" en="Hi! I’m Caio Neves" /></h3>
          <p class="about-handle">@caioqneves</p>
          <div class="about-text">
            <T html
              pt="<p>Designer gráfico e de UX/UI, com foco em identidade visual, interfaces digitais e direção de arte. Acredito que bom design é aquele que comunica com clareza e deixa uma impressão duradoura.</p><p>Baseado no Brasil, disponível para projetos nacionais e internacionais.</p>"
              en="<p>Graphic and UX/UI designer focused on visual identity, digital interfaces and art direction. I believe good design communicates clearly and leaves a lasting impression.</p><p>Based in Brazil, available for national and international projects.</p>" />
          </div>
          <p class="about-cta"><T pt="entre em contato ou veja mais sobre mim:" en="get in touch or see more about me:" /></p>
          <div class="about-links">
            <a class="link-btn" href={site.linkedin.url} target="_blank" rel="noopener">LinkedIn <Fragment set:html={arrow} /></a>
            <a class="link-btn" href={site.instagram.url} target="_blank" rel="noopener">Instagram <Fragment set:html={arrow} /></a>
            <a class="link-btn" href={site.behance.url} target="_blank" rel="noopener">Behance <Fragment set:html={arrow} /></a>
            <button class="link-btn link-btn--wide" id="copyEmail" data-email={site.email} type="button"><span>{site.email}</span><Fragment set:html={copy} /></button>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const botoes = document.querySelectorAll<HTMLButtonElement>('.seg-btn');
  const cards = document.querySelectorAll<HTMLElement>('.card');
  const vazio = document.getElementById('gridVazio')!;
  const seg = document.querySelector<HTMLElement>('.seg')!;
  const ind = seg.querySelector<HTMLElement>('.seg-ind')!;
  const validos = new Set([...botoes].map((b) => b.dataset.area));

  // o "bloco" vermelho que desliza até a opção escolhida
  function posicionar() {
    const ativo = seg.querySelector<HTMLElement>('[aria-pressed="true"]');
    if (!ativo) return;
    ind.style.width = ativo.offsetWidth + 'px';
    ind.style.transform = `translateX(${ativo.offsetLeft}px)`;
    seg.classList.add('has-ind');
  }

  function aplicar(area: string, { hash = true, animar = true } = {}) {
    let i = 0;
    cards.forEach((c) => {
      const ok = area === 'todos' || c.dataset.area === area;
      c.hidden = !ok;
      if (ok) c.classList.add('is-in');
      if (ok && animar) {                       // reentrada escalonada dos cards
        c.style.setProperty('--i', String(i++));
        c.classList.remove('rise'); void c.offsetWidth; c.classList.add('rise');
      }
    });
    vazio.hidden = [...cards].some((c) => !c.hidden);
    botoes.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.area === area)));
    posicionar();
    if (hash) history.replaceState(null, '', area === 'todos' ? '#trabalhos' : '#' + area);
  }

  botoes.forEach((b) => b.addEventListener('click', () => aplicar(b.dataset.area!)));

  // reposiciona se a largura mudar (troca PT/EN, rotação do celular, fontes carregando)
  new ResizeObserver(posicionar).observe(seg);
  document.fonts?.ready.then(posicionar);
  posicionar();
  requestAnimationFrame(() => seg.classList.add('ready'));   // só depois: liga a animação

  // links diretos: /#ux, /#grafico …
  function porHash() {
    const h = location.hash.slice(1);
    if (validos.has(h) && h !== 'todos') {
      aplicar(h, { hash: false, animar: false });
      document.getElementById('trabalhos')?.scrollIntoView();
    }
  }
  window.addEventListener('hashchange', porHash);
  porHash();
</script>

<script>
  // copiar e-mail
  const copiar = document.getElementById('copyEmail');
  copiar?.addEventListener('click', async () => {
    const el = copiar.querySelector('span')!, original = el.textContent;
    try {
      await navigator.clipboard.writeText(copiar.dataset.email!);
      el.textContent = document.documentElement.lang === 'en-US' ? 'Copied!' : 'Copiado!';
    } catch { location.href = 'mailto:' + copiar.dataset.email; return; }
    setTimeout(() => (el.textContent = original), 1800);
  });
</script>

<script>
  // "Contato" no cabeçalho: leva ao Sobre mim e dá um "hover" rápido nos botões, um depois do outro
  const sobre = document.getElementById('sobre');
  const links = document.querySelectorAll<HTMLElement>('.about-links .link-btn');

  function pulsar() {
    links.forEach((b, i) => setTimeout(() => {
      b.classList.remove('pulse'); void b.offsetWidth; b.classList.add('pulse');
    }, i * 90));
  }
  function irParaContato() {
    if (!sobre || !sobre.offsetParent) return false;     // seção não está visível: deixa o link agir normalmente
    sobre.scrollIntoView({ behavior: 'smooth', block: 'start' });
    let feito = false;
    const fim = () => { if (!feito) { feito = true; pulsar(); } };
    addEventListener('scrollend', fim, { once: true });  // quando a rolagem termina…
    setTimeout(fim, 750);                                // …ou, no máximo, depois de 0,75 s
    return true;
  }

  document.querySelectorAll('a[href$="#contato"]').forEach((a) =>
    a.addEventListener('click', (e) => { if (irParaContato()) e.preventDefault(); }));
  addEventListener('hashchange', () => { if (location.hash === '#contato') irParaContato(); });
  if (location.hash === '#contato') setTimeout(irParaContato, 300);   // veio de outra página (ex.: de um projeto)
</script>
